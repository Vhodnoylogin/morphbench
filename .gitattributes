# cmd.exe loses its place in a batch file that has LF endings and non-ASCII bytes:
# the lines are then run in fragments. Batch files get CRLF, on every machine.
*.cmd text eol=crlf
*.bat text eol=crlf

# Maintained cover artwork is an authoritative source resource, not generated output.
/src/main/resources/branding/cover-v1.png filter=lfs diff=lfs merge=lfs -text

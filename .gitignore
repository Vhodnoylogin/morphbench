# Продукты сборки и окружения в репозиторий не попадают.
build/
dist/
.venv/
models/
__pycache__/
*.pyc

# Логи, токены и локальные настройки - у каждой машины свои.
*.log
*-token.txt
build.local.json

# Черновики прогонов.
session.jsonl
*.wav
*.bak-*

# Настройки создаются при первом запуске и у каждой машины свои.
morphbench.json

# Точка входа для MO2: продукт сборки, собирается из launcher/morphbench.cs командой launcher/build.cmd.
/morphbench.exe
# Что окно запуска помнит между запусками - у каждой машины своё.
/morphbench.launcher.json

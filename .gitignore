# Продукты сборки и окружения в репозиторий не попадают.
build/
dist/
target/
.venv/
models/
__pycache__/
*.pyc

# Логи, токены и локальные настройки - у каждой машины свои.
*.log
*-token.txt
build.local.json

# Черновики прогонов.
session.jsonl
*.wav
*.bak-*

# Служебные копии агентов Claude Code - это отдельные репозитории.
.claude/

# Morphbench build products and per-machine state.

# The settings file is made on the first run and every machine has its own.
morphbench.json

# The entry point for MO2: a build product, built from launcher/morphbench.cs by
# launcher/build.cmd.
/morphbench.exe
# What the launcher window remembers between runs - every machine has its own.
/morphbench.launcher.json
/morphbench.diag.json
/morphbench.diag.png
/addons/
/src/main/addons/
/src/main/morphbench.launcher.json
/src/main/morphbench.diag.json
/src/main/morphbench.diag.png

# Preview of the icon - an intermediate product of make-icon.py. The icon itself, the .ico,
# is versioned through LFS: those are the bytes that travel inside morphbench.exe.
/src/main/launcher/morphbench.png
/src/main/launcher/morphbench.ico
.morphbench-no-bytecode/
